cmake_minimum_required(VERSION 3.20)
foreach(mode exports dependents)
  execute_process(COMMAND "${DUMPBIN}" /${mode} "${DLL}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect DLL ${mode}: ${output}\n${error}")
  endif()
  if(mode STREQUAL "exports")
    string(REGEX MATCHALL "[ \t]+[0-9]+[ \t]+[0-9A-F]+[ \t]+[0-9A-F]+[ \t]+[^ \r\n]+" symbols "${output}")
    list(LENGTH symbols count)
    if(NOT count EQUAL 5)
      message(FATAL_ERROR "Expected exactly five iko API exports: ${output}")
    endif()
    foreach(symbol IN LISTS symbols)
      if(NOT symbol MATCHES "\\?(Tessellate|ListSurfaces|WriteObj|WriteBinaryStl|StatusName)@iko@@")
        message(FATAL_ERROR "Unexpected DLL export: ${symbol}")
      endif()
    endforeach()
  elseif(output MATCHES "[ \t](TK[^ \r\n]*|[Oo][Cc][Cc][Tt][^ \r\n]*)\\.[Dd][Ll][Ll]")
    message(FATAL_ERROR "The SDK depends on an external OCCT DLL: ${output}")
  endif()
endforeach()
execute_process(COMMAND "${DUMPBIN}" /headers "${IMPLIB}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT output MATCHES "DLL name[ \t]*:[ \t]*iko_tessellationd?\\.dll")
  message(FATAL_ERROR "The .lib is not an iko DLL import library: ${output}\n${error}")
endif()
file(SIZE "${DLL}" size)
message(STATUS "Exactly five iko exports, no OCCT DLL dependencies; DLL size ${size} bytes")
